<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net10.0-windows10.0.17763.0</TargetFramework>        <!-- 最低系统版本：Windows 10 1809 (build 17763)。
            因代码使用了 WinRT 定位 API (Windows.Devices.Geolocation)，最低不能低于 1607；
            1809 是最稳妥且官方充分支持的下限。 -->
        <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>        <Nullable>enable</Nullable>
        <UseWPF>true</UseWPF>
        <LangVersion>preview</LangVersion>
        <IsPackable>false</IsPackable>
        <PackageVersion>2.0.0</PackageVersion>
        <AssemblyVersion>2.0.0.0</AssemblyVersion>
        <FileVersion>2.0.0.0</FileVersion>
        <NeutralLanguage>zh-Hans</NeutralLanguage>
        <UseWindowsForms>True</UseWindowsForms>
        <PackageIcon>original.ico</PackageIcon>
    </PropertyGroup>

    <ItemGroup>
      <PackageReference Include="GuerrillaNtp" Version="3.1.0" />
      <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.0" />
      <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.0" />
      <PackageReference Include="NAudio.Core" Version="2.2.1" />
      <PackageReference Include="NAudio.Wasapi" Version="2.2.1" />
      <PackageReference Include="Serilog.Extensions.Hosting" Version="10.0.0" />
      <PackageReference Include="Serilog.Sinks.Console" Version="6.0.0" />
      <PackageReference Include="Serilog.Sinks.File" Version="6.0.0" />
      <PackageReference Include="Vanara.PInvoke.Kernel32" Version="4.1.2" />
      <PackageReference Include="WPF-UI" Version="2.0.3" />
    </ItemGroup>

    <ItemGroup>
        <Folder Include="Tests"/>
    </ItemGroup>

    <ItemGroup>
        <None Update="Icons\radio.ico">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
        <None Update="original.ico">
            <Pack>True</Pack>
            <PackagePath></PackagePath>
        </None>
    </ItemGroup>

    <ItemGroup>
        <None Include="..\alarm\**" Link="alarm\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>

    <ItemGroup>
        <None Include="..\LICENCE" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>

    <ItemGroup>
        <None Include="..\Readme.md" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>
</Project>
