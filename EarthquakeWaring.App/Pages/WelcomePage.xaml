<Page
    x:Class="EarthquakeWaring.App.Pages.WelcomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="欢迎">
    <StackPanel VerticalAlignment="Center">
        <TextBlock
            FontSize="64"
            FontWeight="Bold"
            Foreground="{DynamicResource TextFillColorPrimaryBrush}"
            Text="欢迎使用 地震预警"
            TextAlignment="Center" />
        <TextBlock
            FontSize="28"
            Foreground="{DynamicResource TextFillColorPrimaryBrush}"
            Text="此 App 非官方提供,仅供学习交流使用, 请勿用于严肃环境"
            TextAlignment="Center" />
        <TextBlock
            FontSize="28"
            Foreground="{DynamicResource TextFillColorPrimaryBrush}"
            Text="本软件与任何官方机构无直接联系，如有侵犯权益请联系开发者"
            TextAlignment="Center" />
        <TextBlock
            FontSize="28"
            Foreground="{DynamicResource TextFillColorPrimaryBrush}"
            Text="App 内避震建议仅供参考，开发者您所采取的行动导致的任何后果不承担责任"
            TextAlignment="Center" />
        <TextBlock
            FontSize="28"
            Foreground="{DynamicResource TextFillColorPrimaryBrush}"
            Text="使用前请前往设置页进行配置"
            TextAlignment="Center" />
        <TextBlock
            FontSize="28"
            Foreground="{DynamicResource TextFillColorPrimaryBrush}"
            Text="关闭本窗口即可进入后台开始预警服务"
            TextAlignment="Center" />
    </StackPanel>
</Page>